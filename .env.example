# متغيرات التشغيل — OpenCode المضمّن
# تم تحديث هذا الملف بناءً على docs/OPENCODE-GATEWAY-CONTRACT.md

# تمكين جلسات العمل (مؤقت حتى ربط التفويض الخادمي)
OPENCODE_EMBEDDED_EXECUTION_ENABLED=0

# مسار среды Bun المطلوبة لتشغيل المصدر المضمّن
OPENCODE_BUN_PATH=/usr/local/bin/bun

# جذر بيئة التشغيل المحلية للمصدر
OPENCODE_BUN_ROOT=/home/user/.opencode-runtime

# بدء التشغيل التلقائي (مُعتمد في Dockerfile)
OPENCODE_EMBEDDED_AUTOSTART=1
